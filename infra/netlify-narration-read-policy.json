{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListPublishedNarration",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::aa-zip-metrics-prod",
      "Condition": { "StringEquals": { "s3:prefix": "reports/" } }
    },
    {
      "Sid": "ReadPublishedNarration",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::aa-zip-metrics-prod/reports/*/*/narration.json"
    }
  ]
}
