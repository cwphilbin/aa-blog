{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListCanonicalStories",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::aa-zip-metrics-prod",
      "Condition": {"StringEquals": {"s3:prefix": "stories/"}}
    },
    {
      "Sid": "ReadCanonicalStoryJson",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::aa-zip-metrics-prod/stories/*/*.json"
    }
  ]
}
