---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ReportSurface from '../../components/ReportSurface.astro';
import { getAllMarkets, getPosts, getReportingMonth } from '../../lib/posts';
import { seatForZip } from '../../lib/seat-directory';
import offeredZips from '../../../public/embed/offered-zips.json';

const published = new Map(getAllMarkets().map(m => [m.zip, m]));
const markets = offeredZips.map(offered => {
  const market = published.get(offered.zip);
  return { zip: offered.zip, name: market?.name || offered.name,
    places: [offered.name], posts: market ? getPosts(market) : [] };
});
const agentsByZip = Object.fromEntries(markets.flatMap(m => {
  const agent = seatForZip(m.zip);
  return agent ? [[m.zip, agent]] : [];
}));
const data = { page: 'markets', markets, agentsByZip, months: [getReportingMonth()],
  mockSignup: false, links: { home: '/market' } };
const title = 'Local Real Estate Market Reports';
const description =
  'Neighborhood-level real estate market reports, home price trends, and video updates — published by local agents on Agents Automated.';
---

<BaseLayout title={title} description={description} ogType="website">
  <ReportSurface data={data} />
</BaseLayout>
