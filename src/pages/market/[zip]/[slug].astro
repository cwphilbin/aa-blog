---
import SeatByline from '../../../components/SeatByline.astro';
import MonthlyArticle from '../../../components/MonthlyArticle.astro';
import { seatForZip } from '../../../lib/seat-directory';
import { agentSchema, openingSentence, headlineStat } from '../../../lib/seat-agents';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getAllMarkets, coverImage } from '../../../lib/posts';
export function getStaticPaths(){return getAllMarkets().flatMap(m=>[...new Set([...m.posts.map(p=>p.slug),...(m.legacySlugs||[])])].map(slug=>({params:{zip:m.zip,slug},props:{market:m,post:m.posts.find(p=>p.slug===slug)}})));}
const {market,post}=Astro.props;
const seat=seatForZip(market.zip);
const title=post?.title||`Monthly report unavailable · ZIP ${market.zip}`;
const canonical=`${market.url.replace(/\/$/,'')}/${Astro.params.slug}`;
const jsonLd=post?[{'@context':'https://schema.org','@type':['Article','BlogPosting'],headline:title,description:post.summary,datePublished:post.date,author:seat?agentSchema(seat):{'@type':'Organization',name:'Agents Automated',url:'https://agentsautomated.com/'},mainEntityOfPage:{'@type':'WebPage','@id':canonical},...(coverImage(post)&&{image:[coverImage(post)]})}]:[];
---
<BaseLayout title={title} description={post?.summary||'The new monthly PDF-narration report has not been published for this ZIP and month.'} canonical={canonical} jsonLd={jsonLd} ogType={post?'article':'website'} image={post&&coverImage(post)}>
  <nav class="crumbs"><a href="/market">Markets</a> / <a href={`/market/${market.zip}`}>ZIP {market.zip}</a></nav>

  {post?.monthlyReport?<MonthlyArticle post={post} agent={market.agent} zip={market.zip} marketName={market.name}/>:<section><h1>{title}</h1><p>The new monthly PDF-narration report has not been published for this ZIP and month. Earlier feed posts are not shown.</p><a href={`/market/${market.zip}`}>View available monthly reports</a></section>}
</BaseLayout>
