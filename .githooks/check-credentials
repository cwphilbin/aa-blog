#!/usr/bin/env python3
"""Reject AWS credentials/signing fields in any staged file; never print values."""
import re
import subprocess
import sys

fields=re.compile(b'X-Amz-'+b'(?:Credential|Security-Token)',re.IGNORECASE)
keys=re.compile(b'(?:ASIA|AKIA)[A-Z0-9]{16}')
paths=subprocess.check_output(['git','diff','--cached','--name-only','--diff-filter=ACMRT','-z']).split(b'\0')
blocked=[]
for path in filter(None,paths):
    raw=subprocess.check_output([b'git',b'show',b':'+path])
    if fields.search(raw) or keys.search(raw):blocked.append(path.decode('utf-8','backslashreplace'))
if blocked:
    print('Commit blocked: AWS credentials or signing parameters detected in:',file=sys.stderr)
    for path in blocked:print('  '+repr(path),file=sys.stderr)
    sys.exit(1)
